# =============================================================================
# PhotoVault Environment Variables
# Copy to .env.local and fill in values
# =============================================================================

# --- Supabase (REQUIRED) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Cloudflare R2 Storage (REQUIRED) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=photovault
# R2_PUBLIC_URL=               # Optional: public bucket URL for direct access

# --- Application (REQUIRED in production) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000   # Must be the production URL in prod

# --- Cron Security (REQUIRED in production) ---
# CRON_SECRET=                 # Random string to authenticate Vercel Cron requests

# --- Upstash Redis (optional — enables rate limiting + caching) ---
# Graceful no-op if not configured
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxx...

# --- Google APIs (optional — enables Google Drive import) ---
# NEXT_PUBLIC_GOOGLE_API_KEY=
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_GOOGLE_APP_ID=
